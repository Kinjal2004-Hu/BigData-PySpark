# CustomerIQ local development configuration
# Copy to .env and adjust if needed. Works without Docker.

# SQLite database file (relative to repo root)
DATABASE_URL=sqlite:///data/customeriq.db

# Spark
SPARK_MASTER=local[2]
SPARK_APP_NAME=CustomerIQ
KMEANS_K=6
KMEANS_SEED=42
KMEANS_MAX_ITER=50
SPARK_SHUFFLE_PARTITIONS=8

# Upload limits
MAX_UPLOAD_MB=512
PREVIEW_ROWS=10

# Analysis reference date policy: "dataset_max_plus_one" (default) or fixed ISO date
REFERENCE_DATE_POLICY=dataset_max_plus_one

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Windows Hadoop winutils (Spark local file writes)
HADOOP_HOME=C:\hadoop
